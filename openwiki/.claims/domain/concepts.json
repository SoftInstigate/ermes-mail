        }
      ]
    },
    {
      "id": "claim_58af9fbf0aae4430bb710027a47bd032",
      "statement": "EmailService.shutdown(long) calls executor.shutdown(), then awaitTermination(). If the timeout elapses, it calls shutdownNow() and logs abandoned tasks. If interrupted, it forces shutdownNow() and re-interrupts the thread. If the executor was never created, shutdown is a no-op.",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/softinstigate/ermes/mail/EmailService.java#L163-L183",
          "version": "repo-lines-v1:sha256:a832e2a7b9b383b457ce7048b6b0a7a55c4a834edca09a9c7c9d4a04da887fbc:"
