    {
      "id": "claim_a9738856e77f46128064e30e355d9a81",
      "statement": "When threadPoolSize is 0, EmailService creates no executor; send() executes synchronously via CompletableFuture.completedFuture() and returns an already-completed Future. shutdown() is a no-op, and send() continues to work after shutdown().",
      "evidence": [
        {
          "resource": "repo://src/main/java/com/softinstigate/ermes/mail/EmailService.java#L91-L138",
