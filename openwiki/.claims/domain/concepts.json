    {
      "id": "claim_92326f9044934e79a910cb3b2f5d0ccb",
      "statement": "EmailService.send() throws IllegalStateException with message 'Cannot send email: EmailService has been shut down' when called after shutdown() with threadPoolSize > 0, because the executor's isShutdown() check fails.",
      "evidence": [
